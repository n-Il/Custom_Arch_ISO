{
    "archinstall_language": "English",
    "bootloader": "Grub",
    "custom_commands": [

        "echo 'start services'",
        "systemctl enable --now libvirtd.service",
        "systemctl enable --now NetworkManager.service",
        
        "echo 'add users to group'",
        "usermod -aG libvirt USERNAME",

        "echo 'create folder used by logging for awesome'",
        "mkdir /home/USERNAME/.cache",
        "mkdir /home/USERNAME/.cache/awesome",
        
        "echo 'move files'",
        "mv /etc/install-files/home/.bashrc /home/USERNAME/",
        "mv /etc/install-files/home/.bash_profile /home/USERNAME/",
        "mv /etc/install-files/home/.vimrc /home/USERNAME/",
        "mv /etc/install-files/home/.xinitrc /home/USERNAME/",
        "mv /etc/install-files/home/.Xdefaults /home/USERNAME/",
        "mv /etc/install-files/home/.vim /home/USERNAME/",
        "mv /etc/install-files/home/.mozilla /home/USERNAME/",
        "mkdir /home/USERNAME/.config",
        "mkdir /home/USERNAME/.config/awesome",
        "mv /etc/install-files/home/.config/awesome /home/USERNAME/.config/",
        
        "mkdir /etc/X11/xorg-conf-d/",
        "mv /etc/install-files/etc/X11/xorg.conf.d/30-touchpad.conf /etc/X11/xorg.conf.d/",
        "cat /etc/install-files/etc/environment >> /etc/environment",
        
        "mv /etc/install-files/etc/libvirt/libvirtd.conf /etc/libvirt/libvirtd.conf",

        "echo '/etc/libvirt/qemu.conf configuration'",
        "sudo sed -i -E 's/^#+[[:space:]]*(user|group) = \"libvirt-qemu\"/\\1 = \"USERNAME\"/' /etc/libvirt/qemu.conf",

        "echo 'change file permissions'",
        "chown -R USERNAME:USERNAME /home/USERNAME",

        "sed -zi 's|\\n\\[customrepo\\]\\nSigLevel = Optional TrustAll\\nServer = file:///etc/customrepo||' /etc/pacman.conf"
    ],
